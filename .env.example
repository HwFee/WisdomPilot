# ============================================
# 智码领航 Environment Configuration
# Copy this file to backend/.env and fill in values.
# NEVER commit backend/.env to version control.
# ============================================

# ===== Application =====
APP_NAME=智码领航
DEBUG=false

# ===== Database =====
DATABASE_URL=sqlite+aiosqlite:///./data.db

# ===== JWT Authentication =====
# 留空,start_services.py 首次启动会自动生成 32 字节随机值
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== External Services =====
JUDGE0_BASE_URL=https://ce.judge0.com

# ===== Rate Limiting =====
AUTH_RATE_PER_MINUTE=10
CODE_EXEC_RATE_PER_MINUTE=5

# ===== AI 内容生成 (DeepSeek / OpenAI / SiliconFlow 等) =====
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.5
AI_BASE_URL=https://api.deepseek.com
AI_LOCAL_FIRST=false

# ===== Embedding 向量匹配 (推荐硅基流动) =====
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSIONS=1024

# ===== 前端 =====
# 前端需要时手动建 frontend/.env.local 并写这一行
NEXT_PUBLIC_API_URL=http://localhost:8000
