# ============================================
# 智码领航 Environment Configuration
# Copy this file to backend/.env and fill in values.
# NEVER commit backend/.env to version control.
# ============================================

# ===== Application =====
APP_NAME=智码领航
DEBUG=false

# ===== Database =====
DATABASE_URL=sqlite+aiosqlite:///./data.db

# ===== JWT Authentication =====
# 留空,start_services.py 首次启动会自动生成 32 字节随机值
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== Rate Limiting =====
AUTH_RATE_WINDOW_MAX_REQUESTS=10
AUTH_RATE_WINDOW_SECONDS=60

# ===== CORS =====
# 生产环境允许的前端来源（逗号分隔）。DEBUG=false 时须显式配置，留空则不放行任何跨域来源；
# 本地开发地址（localhost / 私有网段）由 DEBUG=true 时的正则放行，无需在此配置。
# 示例：CORS_ORIGINS=https://app.example.com,https://www.example.com
CORS_ORIGINS=

# ===== AI 内容生成 (DeepSeek / OpenAI / SiliconFlow 等) =====
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_TEMPERATURE=0.5
AI_BASE_URL=https://api.deepseek.com
AI_LOCAL_FIRST=false

# ===== Judge0 在线判题（可选）=====
# 竞技场与认证 code 题的判题：配置后走 Judge0 真实判题；留空（默认）则
# 降级为服务端关键字匹配，开发环境无需 Judge0 也能完整使用。
# 示例：JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_BASE_URL=

# ===== 前端 =====
# 前端需要时手动建 frontend/.env.local 并写这一行
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
