# ============================================
# 环境变量配置
# ============================================
# 请修改下面的值为你的实际配置
# ============================================

# 安全密钥（至少32位随机字符串）
SECRET_KEY=your-secret-key-change-this-to-random-32-chars

# SiliconFlow API 密钥（主要 AI 服务）
AI_API_KEY=your-siliconflow-api-key

# AI 模型配置
AI_MODEL=Qwen/Qwen2.5-72B-Instruct

# MiniMax API（可选，用于某些功能）
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7

# Judge0 代码执行服务
JUDGE0_BASE_URL=https://ce.judge0.com
