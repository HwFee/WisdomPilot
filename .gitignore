*.png
!.github/**/*.png

# Local config files (never commit these)
*.local
*.local.json
*.local.yaml
*.local.yml
config.local.*
settings.local.*

# Everything-claude-code
everything-claude-code/

# Downloaded data
backend/data/
backend/downloads/

