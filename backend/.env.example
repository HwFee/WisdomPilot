# ============================================
# AIcodiingTeach Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================

# Application
APP_NAME=AIcodiingTeach
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data.db

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# External Services
JUDGE0_BASE_URL=https://ce.judge0.com

# Rate Limiting
AUTH_RATE_PER_MINUTE=10
CODE_EXEC_RATE_PER_MINUTE=5

# ============================================
# AI Configuration (for content generation, chat, etc.)
# ============================================
# Supported providers: openai, minimax, anthropic, ollama, local
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_BASE_URL=
AI_LOCAL_FIRST=false

# ============================================
# MiniMax Configuration (for enhanced quiz generation)
# ============================================
# MiniMax uses Anthropic-compatible API format
# Get your API key from: https://platform.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7

# ============================================
# Embedding Configuration (for vector matching/recommendation)
# ============================================
# 推荐使用硅基流动 API (https://cloud.siliconflow.cn)
# 免费额度：每月 100 万 tokens
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 推荐模型：BAAI/bge-large-zh-v1.5 (中文优化，1024维)
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSIONS=1024
